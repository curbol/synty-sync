# Account-specific config (customer id, machine paths) — never committed.
config.toml

# Captured browser sessions (contain cookies) — never committed.
session.curl
*.curl
cookies.txt

# A project manifest and its lockfile belong with the consuming project, not this tool
# repo; ignored here defensively so running the tool from this directory never commits
# them (the committed synty-sync.example.toml is not matched by the exact name).
synty-sync.toml
synty-sync.lock.json

# Built binary.
/synty-sync
