# Account-specific config (customer id, machine paths) — never committed.
config.toml

# Captured browser sessions (contain cookies) — never committed.
session.curl
*.curl
cookies.txt

# A project manifest and its lockfile belong with the consuming project, not this tool
# repo; ignored here defensively so running the tool from this directory never commits
# them (the committed synty-sync.example.toml is not matched by the exact name).
synty-sync.toml
synty-sync.lock.json

# Built binaries. Named rather than globbed: `go build ./cmd/scrubfixtures` writes
# ./scrubfixtures into the working directory.
/synty-sync
/scrubfixtures

# Raw portal captures and the real->fake scrub map they are scrubbed through are
# account PII. cmd/scrubfixtures reads both from here by default.
.longrun/

# Release build output (release.yml writes it; a local run of the same loop would too).
dist/
